# Valeurs par défaut de DÉVELOPPEMENT, sans aucun secret réel.
# Surchargez-les dans .env.local (non versionné) ou via l'environnement.
APP_ENV=dev
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
DATABASE_URL="mysql://resto:resto@127.0.0.1:3306/resto?serverVersion=8.0.32&charset=utf8mb4"
# API Open Food Facts (gratuite, sans clé)
OFF_BASE_URI=https://world.openfoodfacts.org
