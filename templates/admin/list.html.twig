{% extends 'base.html.twig' %}
{% block title %}{{ title }} · Resto Manager{% endblock %}
{% block body %}
<div class="actions"><h1 style="margin:0">{{ title }}</h1><a class="btn" href="{{ path(new) }}">+ Nouveau</a></div>
<table>
    <tr>{% for label in columns|keys %}<th>{{ label }}</th>{% endfor %}<th></th></tr>
    {% for row in rows %}
    <tr>
        {% for prop in columns %}<td>{{ attribute(row, prop) }}</td>{% endfor %}
        <td class="r">{% if edit %}<a href="{{ path(edit, {id: row.id}) }}">Modifier</a>{% endif %}</td>
    </tr>
    {% else %}<tr><td colspan="{{ columns|length + 1 }}" class="muted">Rien pour l'instant.</td></tr>{% endfor %}
</table>
{% endblock %}
